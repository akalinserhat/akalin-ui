{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@akalin/ui": [
        "./src/index.ts"
      ],
      "@akalin/ui/*": [
        "./src/*"
      ],
      "@akalin/ai-assistants": [
        "../akalin-ai-assistants/src/index.ts"
      ],
      "@akalin/ai-assistants/*": [
        "../akalin-ai-assistants/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}